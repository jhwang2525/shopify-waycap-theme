  <div class="bb-search-drawer" id="bb-search-drawer" role="dialog" aria-label="Search">
    <div class="bb-search-drawer__header">
      <button type="button" class="bb-search-drawer__close" id="bb-search-close" aria-label="Close search">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <line x1="19" y1="5" x2="5" y2="19"></line>
          <line x1="5" y1="5" x2="19" y2="19"></line>
        </svg>
      </button>
      <span class="bb-search-drawer__title">Search</span>
      <div style="width:28px;"></div>
    </div>

    <div class="bb-search-drawer__input-wrap">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" class="bb-search-drawer__input" id="bb-search-input" placeholder="Search here..." autocomplete="off" />
      <button type="button" class="bb-search-drawer__input-clear" id="bb-search-clear" aria-label="Clear search">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="bb-search-drawer__body" id="bb-search-body">
      <div class="bb-search-drawer__top-searches">
        <h3>Top Searches</h3>
        <ul class="bb-search-drawer__results-list">
          <li onclick="bbSearchTerm('Snapback')">Snapback</li>
          <li onclick="bbSearchTerm('Trucker')">Trucker</li>
          <li onclick="bbSearchTerm('Waterproof')">Waterproof</li>
          <li onclick="bbSearchTerm('Suede')">Suede</li>
          <li onclick="bbSearchTerm('Flexfit')">Flexfit</li>
          <li onclick="bbSearchTerm('Bucket Hat')">Bucket Hat</li>
          <li onclick="bbSearchTerm('Snapback')">5 Panel</li>
          <li onclick="bbSearchTerm('Rope Hat')">Rope Hat</li>
        </ul>
      </div>
    </div>
  </div>

  <script>
  (function() {
    var openBtn = document.getElementById('bb-search-open');
    var openBtnMobile = document.getElementById('bb-search-open-mobile');
    var closeBtn = document.getElementById('bb-search-close');
    var overlay = document.getElementById('bb-search-overlay');
    var drawer = document.getElementById('bb-search-drawer');
    var input = document.getElementById('bb-search-input');
    var clearBtn = document.getElementById('bb-search-clear');
    var body = document.getElementById('bb-search-body');

    var topSearchesHTML = body ? body.innerHTML : '';

    function openDrawer() {
      if (!drawer || !overlay) return;
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      setTimeout(function() { if (input) input.focus(); }, 300);
    }

    function closeDrawer() {
      if (!drawer || !overlay) return;
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    if (openBtn) openBtn.addEventListener('click', openDrawer);
    if (openBtnMobile) openBtnMobile.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (overlay) overlay.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeDrawer();
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', function() {
        if (input) input.value = '';
        clearBtn.classList.remove('visible');
        if (body) body.innerHTML = topSearchesHTML;
        if (input) input.focus();
      });
    }

    var searchTimer;

    if (input) {
      input.addEventListener('input', function() {
        var val = this.value.trim();
        if (clearBtn) clearBtn.classList.toggle('visible', val.length > 0);
        clearTimeout(searchTimer);
        if (val.length < 2) {
          if (body) body.innerHTML = topSearchesHTML;
          return;
        }
        searchTimer = setTimeout(function() { bbSearchQuery(val); }, 350);
      });

      input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && this.value.trim()) {
          window.location.href = '/search?q=' + encodeURIComponent(this.value.trim()) + '&type=product';
        }
      });
    }

    window.bbSearchTerm = function(term) {
      if (input) input.value = term;
      if (clearBtn) clearBtn.classList.add('visible');
      bbSearchQuery(term);
    };

    window.bbSearchQuery = function(q) {
      if (!body) return;
      body.innerHTML = '<div class="bb-search-loading">Searching...</div>';
      fetch('/search/suggest.json?q=' + encodeURIComponent(q) + '&resources[type]=product&resources[limit]=5')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var products = (data.resources && data.resources.results && data.resources.results.products) || [];
          if (!products.length) {
            body.innerHTML = '<div class="bb-search-loading">No results found for "' + q + '"</div><a href="/search?q=' + encodeURIComponent(q) + '&type=product" class="bb-search-see-all">Search all products</a>';
            return;
          }
          var html = products.map(function(p) {
            var img = p.featured_image && p.featured_image.url ? p.featured_image.url + '&width=120' : '';
           var price = p.price ? ('$' + parseFloat(p.price).toFixed(2)) : '';
            return '<a href="' + p.url + '" class="bb-search-result-item">' +
              (img ? '<img src="' + img + '" alt="' + p.title + '" />' : '<div style="width:56px;height:56px;background:#f5f5f5;border-radius:4px;flex-shrink:0;"></div>') +
              '<div class="bb-search-result-info">' +
                '<div class="bb-search-result-title">' + p.title + '</div>' +
                '<div class="bb-search-result-price">' + price + ' / pc</div>' +
              '</div></a>';
          }).join('');
          html += '<a href="/search?q=' + encodeURIComponent(q) + '&type=product" class="bb-search-see-all">See All Results</a>';
          body.innerHTML = html;
        })
        .catch(function() {
          body.innerHTML = '<a href="/search?q=' + encodeURIComponent(q) + '&type=product" class="bb-search-see-all">See All Results for "' + q + '"</a>';
        });
    };
  })();
  </script>

</div>

<div class="header-wrapper no-js">
  {% capture main_icons %}
    <div class="header-icons">
      <ul>
        {% if section.settings.search-enable %}
          <li>
            <a href="{{ routes.search_url }}" class="icons--inline search-show alt-focus header-link" title="{{ 'layout.header.search' | t }}" tabindex="0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              {% if section.settings.label-enable %}<span class="header--supporting-text">{{ 'layout.header.search' | t }}</span>{% endif %}
            </a>
          </li>
        {% endif %}

        {% if shop.customer_accounts_enabled %}
          {% if customer %}
            <li{% if section.settings.search-enable == false %} class="login-no-padding"{% endif %}>
              <a href="{{ routes.account_url }}" class="icons--inline alt-focus header-link" title="{{ 'customer.account.title' | t }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                {% if section.settings.label-enable %}<span class="header--supporting-text">{{ 'layout.header.account' | t }}</span>{% endif %}
              </a>
            </li>
          {% else %}
            <li{% if section.settings.search-enable == false %} class="login-no-padding"{% endif %}>
              <a href="{{ routes.account_login_url }}" class="icons--inline alt-focus header-link" title="{{ 'layout.customer.log_in' | t }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                {% if section.settings.label-enable %}<span class="header--supporting-text">{{ 'layout.header.account' | t }}</span>{% endif %}
              </a>
            </li>
          {% endif %}
        {% endif %}

        <li>
          <a href="{{ routes.cart_url }}" class="icons--inline header-link slide-menu" title="{{ 'layout.header.your_cart' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            {% if section.settings.label-enable %}
              <span class="header--supporting-text">{{ 'layout.header.your_cart' | t }}
                {% case section.settings.cart-number %}
                  {% when 'quantity' %} - <span class="cart-item-count-header cart-item-count-header--quantity">{{ cart.item_count }}</span>
                  {% when 'total' %} - <span class="cart-item-count-header cart-item-count-header--total">{{ cart.total_price | money }}</span>
                {% endcase %}
              </span>
            {% else %}
              {% case section.settings.cart-number %}
                {% when 'quantity' %}
                  <span class="header--supporting-text"><span class="cart-item-count-header cart-item-count-header--quantity">{{ cart.item_count }}</span></span>
                {% when 'total' %}
                  <span class="header--supporting-text"><span class="cart-item-count-header cart-item-count-header--total">{{ cart.total_price | money }}</span></span>
              {% endcase %}
            {% endif %}
          </a>
        </li>
      </ul>
    </div>
  {% endcapture %}

  <header id="site-header">
    <div>
      <div class="header-content logo-placement-within-wrapper">
        <div class="logo-placement-within-wrapper__item{% if section.settings.nav-placement == 'center' %} empty{% endif %}">
          {{ left_navigation }}
        </div>
        <div class="logo-placement-within-wrapper__item{% if logo %} logo-placement-within-wrapper--logo{% endif %}">
          {{ header_logo }}
        </div>
        <div class="logo-placement-within-wrapper__item">
          {{ main_icons }}
        </div>
      </div>
    </div>
  </header>

  <nav>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-menu" id="iconAnim"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    <input class="no-js-nav-button" type="checkbox">
    <div class="header-menu-wrapper">
      {% if section.settings.main_linklist != '' %}
        <div class="main-navigation-wrapper-main">
          <div id="main-navigation-wrapper" class="main-navigation-wrapper{% if section.blocks.size > 0 %} mega-menu-wrapper{% endif %}">
            {% render 'nav--main' with section.settings.main_linklist, class: 'nav-pills', section: section %}
          </div>
        </div>
      {% endif %}
    </div>
  </nav>
</div>

