<style>
  .site-header__logo-image img,
  .overlay-logo-image {
    max-width: {{ section.settings.logo_max_width }}px;
  }

  @media screen and (max-width: 767px) {
    .site-header__logo-image img,
    .overlay-logo-image {
      max-width: {{ section.settings.logo_max_width_mobile }}px;
    }

    .site-header__logo-image img,
    .overlay-logo-image {
      width: {{ section.settings.logo_max_width_mobile }}px;
    }

    .logo-placement-within-wrapper--logo {
      width: {{ section.settings.logo_max_width_mobile }}px;
      flex-basis: {{ section.settings.logo_max_width_mobile }}px;
    }
  }

    .site-header__logo-image img,
    .overlay-logo-image {
      width: {{ section.settings.logo_max_width }}px;
    }

    .logo-placement-within-wrapper--logo {
      width: {{ section.settings.logo_max_width }}px;
      flex-basis: {{ section.settings.logo_max_width }}px;
    }

  #site-header svg:not(.icon-caret), .sticky-header-wrapper svg {
    height: 24px;
  }

  .header-icons.cart-link ul li {
    margin-left: 12px;
  }

  @media screen and (max-width: 767px) {
    #site-header svg, .sticky-header-wrapper svg {
        height: 24px;
    }
  }

  .top-search #search-wrapper {
    background: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--page-background){% else %}var(--header-background){% endif %}!important;
    border-bottom: 1px solid {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--page-background){% else %}var(--header-background){% endif %}!important;
  }

  #top-search-wrapper svg {
    stroke: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-text){% endif %}!important;
  }

  .top-search input {
    color: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-text){% endif %}!important;
  }

  #top-search-wrapper #search_text::placeholder {
    color: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-text){% endif %};
  }

  #top-search-wrapper #search_text::-webkit-input-placeholder {
    color: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-text){% endif %};
  }

  #top-search-wrapper #search_text:-ms-input-placeholder {
    color: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-text){% endif %};
  }

  #top-search-wrapper #search_text::-moz-placeholder {
    color: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-text){% endif %};
  }

  #top-search-wrapper #search_text:-moz-placeholder {
    color: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-text){% endif %};
  }

  .top-search {
    border-bottom: solid 1px {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-border-color){% endif %}!important;
  }

  .predictive-search-group {
    background-color: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--page-background){% else %}var(--header-background){% endif %}!important;
  }

  .search-results__meta {
    background: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--page-background){% else %}var(--header-background){% endif %}!important;
  }

  .search-results__meta .search-results__meta-clear {
    color: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-text){% endif %};
  }

  .search-results-panel .predictive-search-group h2 {
    color: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-text){% endif %};
    border-bottom: solid 1px {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-border-color){% endif %};
  }

  .search-results-panel .predictive-search-group .search-vendor,
  .search-results-panel .predictive-search-group .money {
    color: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-text){% endif %};
  }

  .search--result-group h5 a, .search--result-group h5 a mark {
    color: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-text){% endif %};
  }

  .predictive-loading {
    color: {% if settings.header-background-color == "rgba(0,0,0,0)" %}var(--color-primary){% else %}var(--header-text){% endif %}!important;
  }

  /* Search drawer overlay */
  .bb-search-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.3);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease;
  }
  .bb-search-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* Search drawer panel */
  .bb-search-drawer {
    position: fixed;
    top: 0;
    right: -500px;
    width: 420px;
    max-width: 100%;
    height: 100%;
    background: #fff;
    z-index: 9999;
    transition: right 0.3s ease;
    display: flex;
    flex-direction: column;
    box-shadow: -4px 0 20px rgba(0,0,0,0.12);
  }
  .bb-search-drawer.is-open {
    right: 0;
  }

  .bb-search-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid #e0e0e0;
  }
  .bb-search-drawer__title {
    font-size: 18px;
    font-weight: 600;
    color: #111;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .bb-search-drawer__close {
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  color: #111;
  display: flex;
  align-items: center;
  width: 28px !important;
  flex-shrink: 0;
}
  .bb-search-drawer__close svg {
    width: 20px;
    height: 20px;
  }

  .bb-search-drawer__input-wrap {
    padding: 16px 24px;
    border-bottom: 1px solid #e0e0e0;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .bb-search-drawer__input-wrap svg {
    width: 18px;
    height: 18px;
    color: #666;
    flex-shrink: 0;
  }
  .bb-search-drawer__input {
    flex: 1;
    border: none !important;
    outline: none !important;
    font-size: 15px;
    color: #111;
    padding: 0 !important;
    background: transparent;
  }
  .bb-search-drawer__input::placeholder {
    color: #aaa;
  }
  .bb-search-drawer__input-clear {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: #999;
    display: none;
    align-items: center;
  }
  .bb-search-drawer__input-clear.visible {
    display: flex;
  }
  .bb-search-drawer__input-clear svg {
    width: 16px;
    height: 16px;
  }

  .bb-search-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px;
  }
  .bb-search-drawer__top-searches h3 {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #111;
    margin-bottom: 14px;
  }
  .bb-search-drawer__results-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .bb-search-drawer__results-list li {
    padding: 7px 0;
    font-size: 14px;
    color: #444;
    cursor: pointer;
    border-bottom: 1px solid #f0f0f0;
  }
  .bb-search-drawer__results-list li:hover {
    color: #111;
  }
  .bb-search-drawer__results-list li:last-child {
    border-bottom: none;
  }

  .bb-search-icon-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: currentColor;
    display: flex;
    align-items: center;
  }
  .bb-search-icon-btn svg {
    width: 20px;
    height: 20px;
  }

  .bb-search-result-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid #f0f0f0;
    text-decoration: none;
    color: #111;
  }
  .bb-search-result-item:last-of-type {
    border-bottom: none;
  }
  .bb-search-result-item img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 4px;
    background: #f5f5f5;
    flex-shrink: 0;
  }
  .bb-search-result-info { flex: 1; min-width: 0; }
  .bb-search-result-title {
    font-size: 13px;
    font-weight: 500;
    color: #111;
    margin-bottom: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bb-search-result-price {
    font-size: 12px;
    color: #666;
  }

  .bb-search-see-all {
    display: block;
    width: 100%;
    padding: 14px;
    background: #111;
    color: #fff !important;
    border: none;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    text-align: center;
    text-decoration: none !important;
    margin-top: 16px;
    border-radius: 2px;
  }
  .bb-search-see-all:hover { background: #333; }

  .bb-search-loading {
    font-size: 13px;
    color: #999;
    text-align: center;
    padding: 20px 0;
  }
</style>

{% capture header_logo %}
  <div class="site-header__logo h1 logo-placement--within" itemscope itemtype="http://schema.org/Organization">
    {% capture props %}itemprop="logo"{% endcapture %}
    {% capture alt %}{{ section.settings.logo.alt | default: shop.name }}{% endcapture %}
    {% capture overlayAlt %}{{ section.settings.overlay_logo.alt | default: shop.name }}{% endcapture %}

    {% if section.settings.logo and section.settings.overlay_logo == blank %}
      <a href="{{ routes.root_url }}" itemprop="url" class="site-header__logo-image site-header__logo-image--no-overlay">
        {% render 'responsive-image' with section.settings.logo, alt: alt, props: props %}
      </a>
    {% elsif section.settings.overlay_logo and section.settings.logo == blank %}
      {% if template == 'index' and section.settings.overlay_header %}
        <a href="{{ routes.root_url }}" itemprop="url" class="site-header__logo-image">
          {% render 'responsive-image' with section.settings.overlay_logo, alt: overlayAlt, props: props, class: "overlay-logo-image" %}
        </a>
        <a class="site-header__logo-link alt-focus header-link custom-font overlay-logo-image--sticky" href="{{ routes.root_url }}" itemprop="url">{{ shop.name }}</a>
      {% else %}
        <a class="site-header__logo-link alt-focus header-link custom-font" href="{{ routes.root_url }}" itemprop="url">{{ shop.name }}</a>
      {% endif %}
    {% elsif section.settings.overlay_logo and section.settings.logo %}
      <a href="{{ routes.root_url }}" itemprop="url" class="site-header__logo-image">
        {% if template == 'index' and section.settings.overlay_header %}
          {% render 'responsive-image' with section.settings.overlay_logo, alt: overlayAlt, props: props, class: "overlay-logo-image" %}
          {% render 'responsive-image' with section.settings.logo, alt: alt, props: props, class: "overlay-logo-image--sticky" %}
        {% else %}
          {% render 'responsive-image' with section.settings.logo, alt: alt, props: props %}
        {% endif %}
      </a>
    {% else %}
      <a class="site-header__logo-link alt-focus header-link custom-font" href="{{ routes.root_url }}" itemprop="url">{{ shop.name }}</a>
    {% endif %}
  </div>
{% endcapture %}

<div class="header-wrapper js{% if section.settings.overlay_header %} header-wrapper--overlay{% endif %}" data-wetheme-section-type="header" data-wetheme-section-id="{{ section.id }}">

  {% if section.settings.sticky_header %}
    <div class="sticky-header-wrapper">
      <div class="sticky-header-wrapper__inner">
        {% if section.settings.sticky_header_logo %}
          <div class="sticky-header-logo d-none d-lg-block">
            {{ header_logo }}
          </div>
        {% endif %}
        <div class="sticky-header-menu d-none d-lg-block"></div>
        <div class="sticky-header-icons d-none d-lg-flex"></div>
        <div class="sticky-header-search d-none d-lg-block"></div>
        <div class="sticky-mobile-header d-lg-none"></div>
      </div>
    </div>
  {% endif %}

  <div class="header-logo-wrapper" data-section-id="{{ section.id }}" data-section-type="header-section">

    <nav
      id="theme-menu"
      class="mobile-menu-wrapper slideout-panel-hidden"
      role="dialog"
      aria-label="{{ 'general.menu.nav_label' | t }}"
      aria-modal="true"
    >
      {% render 'nav-mobile' %}
    </nav>

    <div class="d-flex d-lg-none">
      <div class="mobile-header--wrapper">
        <div class="mobile-side-column mobile-header-wrap--icons">
          <button
            type="button"
            class="slide-menu slide-menu-mobile alt-focus header-link header-link--button"
            aria-label="{{ 'general.menu.open_nav' | t }}"
            aria-controls="mobile-menu--main-menu"
          >
            <i id="iconAnim" data-feather="menu"></i>
          </button>
          {% if section.settings.search-enable %}
            <button
              type="button"
              class="bb-search-icon-btn icons--inline alt-focus header-link header-link--button"
              aria-label="Open search"
              id="bb-search-open-mobile"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </button>
          {% endif %}
        </div>

        <div class="mobile-logo-column mobile-header-wrap--icons">
          {{ header_logo }}
        </div>

        <div class="mobile-side-column mobile-header-wrap--icons mobile-header-right{% if section.settings.cart-number == 'total' %} show-total{% endif %}">
          {% if shop.customer_accounts_enabled %}
            <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="alt-focus header-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 225 225" fill="none" stroke="currentColor" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"><circle cx="112" cy="65" r="37"/><path d="M46 195c0-36 30-66 66-66s66 30 66 66"/><rect x="84" y="34" width="56" height="21" fill="currentColor" stroke="none" rx="2"/><ellipse cx="137" cy="45" rx="53" ry="8" fill="currentColor" stroke="none"/></svg>
            </a>
          {% endif %}
          {% if settings.cart-type == 'drawer' %}
            <button
              type="button"
              class="alt-focus header-link header-link--button slide-menu slide-menu-cart"
              aria-label="{{ 'cart.general.open_cart' | t }}"
              aria-controls="cartSlideoutAside"
            >
              <i data-feather="{{ section.settings.cart-style }}"></i>
              {% case section.settings.cart-number %}
                {% when 'quantity' %}
                  <span class="header--supporting-text header--mobile-cart-quantity{% if template.name contains 'index' and section.settings.overlay_header %} is-index-overlay{% endif %}"><span class="cart-item-count-header cart-item-count-header--quantity">{{ cart.item_count }}</span></span>
                {% when 'total' %}
                  <span class="header--supporting-text header--mobile-cart-total{% if template.name contains 'index' and section.settings.overlay_header %} is-index-overlay{% endif %}"><span class="cart-item-count-header cart-item-count-header--total" data-hulkapps-cart-total>{{ cart.total_price | money }}</span></span>
              {% endcase %}
            </button>
          {% else %}
            <a href="{{ routes.cart_url }}" class="alt-focus header-link slide-menu">
              <i data-feather="{{ section.settings.cart-style }}"></i>
              {% case section.settings.cart-number %}
                {% when 'quantity' %}
                  <span class="header--supporting-text header--mobile-cart-quantity{% if template.name contains 'index' and section.settings.overlay_header %} is-index-overlay{% endif %}"><span class="cart-item-count-header cart-item-count-header--quantity">{{ cart.item_count }}</span></span>
                {% when 'total' %}
                  <span class="header--supporting-text header--mobile-cart-total{% if template.name contains 'index' and section.settings.overlay_header %} is-index-overlay{% endif %}"><span class="cart-item-count-header cart-item-count-header--total" data-hulkapps-cart-total>{{ cart.total_price | money }}</span></span>
              {% endcase %}
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    {% capture main_navigation %}
      {% if section.settings.main_linklist != '' %}
        <div class="main-navigation-wrapper-main">
          <div id="main-navigation-wrapper" class="main-navigation-wrapper{% if section.settings.nav-placement == 'left' %} main-navigation-wrapper--left{% else %} main-navigation-wrapper--center{% endif %}{% if section.blocks.size > 0 %} mega-menu-wrapper{% endif %}">
            {% render 'nav--main' with section.settings.main_linklist, class: 'nav-pills', section: section %}
          </div>
        </div>
      {% endif %}
    {% endcapture %}

    {% capture left_navigation %}
      {% if section.settings.nav-placement == 'left' %}
        {{ main_navigation }}
      {% endif %}
    {% endcapture %}

    {% capture main_icons %}
      <div class="header-icons cart-link">
        <ul>
          {% if section.settings.search-enable %}
            <li>
              <button type="button" class="bb-search-icon-btn icons--inline alt-focus header-link" aria-label="Open search" id="bb-search-open">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </button>
            </li>
          {% endif %}

          {% if shop.customer_accounts_enabled %}
            {% if customer %}
              <a href="https://waycap-inc.myshopify.com/tools/wallet_details/admin/wk_wallet_front?customer_id={{ customer.id }}&customer_email={{ customer.email }}">{{ shop.metafields.wk_wallet_management.header_label }} {{ shop.metafields.wk_wallet_management.wk_shop_currency }}{{ customer.metafields.wk_wallet_management.wallet_remaning_amount }}</a>
              <a href="{{ routes.account_url }}" class="icons--inline alt-focus header-link" title="{{ 'customer.account.title' | t }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 225 225" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"><circle cx="112" cy="65" r="37"/><path d="M46 195c0-36 30-66 66-66s66 30 66 66"/><rect x="84" y="34" width="56" height="21" fill="currentColor" stroke="none" rx="2"/><ellipse cx="137" cy="45" rx="53" ry="8" fill="currentColor" stroke="none"/></svg>
                {% if section.settings.label-enable %}<span class="header--supporting-text">{{ 'layout.header.account' | t }}</span>{% endif %}
              </a>
              </li>
            {% else %}
              <li{% if section.settings.search-enable == false %} class="login-no-padding"{% endif %}>
                <a href="{{ routes.account_login_url }}" class="icons--inline alt-focus header-link" title="{{ 'layout.customer.log_in' | t }}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 225 225" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"><circle cx="112" cy="65" r="37"/><path d="M46 195c0-36 30-66 66-66s66 30 66 66"/><rect x="84" y="34" width="56" height="21" fill="currentColor" stroke="none" rx="2"/><ellipse cx="137" cy="45" rx="53" ry="8" fill="currentColor" stroke="none"/></svg>
                  {% if section.settings.label-enable %}<span class="header--supporting-text">{{ 'layout.header.account' | t }}</span>{% endif %}
                </a>
              </li>
            {% endif %}
          {% endif %}

          <li>
            {% if settings.cart-type == 'drawer' %}
              <button
                type="button"
                class="icons--inline alt-focus header-link btn-normalize slide-menu{% if settings.cart-type == 'drawer' %} slide-menu-cart{% endif %}"
                title="{{ 'layout.header.your_cart' | t }}"
                aria-label="{{ 'cart.general.open_cart' | t }}"
                aria-controls="cartSlideoutAside"
              >
                <i data-feather="{{ section.settings.cart-style }}"></i>
                {% if section.settings.label-enable %}
                  <span class="header--supporting-text">{{ 'layout.header.your_cart' | t }}
                    {% case section.settings.cart-number %}
                      {% when 'quantity' %} - <span class="cart-item-count-header cart-item-count-header--quantity">{{ cart.item_count }}</span>
                      {% when 'total' %} - <span class="cart-item-count-header cart-item-count-header--total" data-hulkapps-cart-total>{{ cart.total_price | money }}</span>
                    {% endcase %}
                  </span>
                {% else %}
                  {% case section.settings.cart-number %}
                    {% when 'quantity' %}
                      <span class="header--supporting-text"><span class="cart-item-count-header cart-item-count-header--quantity">{{ cart.item_count }}</span></span>
                    {% when 'total' %}
                      <span class="header--supporting-text"><span class="cart-item-count-header cart-item-count-header--total" data-hulkapps-cart-total>{{ cart.total_price | money }}</span></span>
                  {% endcase %}
                {% endif %}
              </button>
            {% else %}
              <a href="{{ routes.cart_url }}" class="icons--inline header-link slide-menu{% if settings.cart-type == 'drawer' %} slide-menu-cart{% endif %}" title="{{ 'layout.header.your_cart' | t }}">
                <i data-feather="{{ section.settings.cart-style }}"></i>
                {% if section.settings.label-enable %}
                  <span class="header--supporting-text">{{ 'layout.header.your_cart' | t }}
                    {% case section.settings.cart-number %}
                      {% when 'quantity' %} - <span class="cart-item-count-header cart-item-count-header--quantity">{{ cart.item_count }}</span>
                      {% when 'total' %} - <span class="cart-item-count-header cart-item-count-header--total">{{ cart.total_price | money }}</span>
                    {% endcase %}
                  </span>
                {% else %}
                  {% case section.settings.cart-number %}
                    {% when 'quantity' %}
                      <span class="header--supporting-text"><span class="cart-item-count-header cart-item-count-header--quantity">{{ cart.item_count }}</span></span>
                    {% when 'total' %}
                      <span class="header--supporting-text"><span class="cart-item-count-header cart-item-count-header--total">{{ cart.total_price | money }}</span></span>
                  {% endcase %}
                {% endif %}
              </a>
            {% endif %}
          </li>
        </ul>
      </div>
    {% endcapture %}

    {% if section.settings.search-enable %}
      {% render 'search-bar' %}
    {% endif %}

    <header id="site-header" class="clearfix d-none d-lg-block">
      <div>
        <div class="header-content logo-placement-within-wrapper">
          <div class="logo-placement-within-wrapper__item{% if section.settings.nav-placement == 'center' %} empty{% endif %}">
            {{ left_navigation }}
          </div>
          <div class="logo-placement-within-wrapper__item{% if logo %} logo-placement-within-wrapper--logo{% endif %}">
            {{ header_logo }}
          </div>
          <div class="logo-placement-within-wrapper__item">
            {{ main_icons }}
          </div>
        </div>
