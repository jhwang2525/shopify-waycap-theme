{% assign discount_data = product.metafields['hulk-volume-discount'].offer %}
{% if discount_data.type == 'json' %}
  {% assign discount_data = discount_data.value %}
{% endif %}

{% assign lowest_price = null %}

{% for offer_pair in discount_data %}
  {% assign offer = offer_pair[1] %}
  
  {% if offer.status == true and offer.price_level.size > 0 %}
    {% assign last_tier = offer.price_level | last %}
    {% assign lowest_price = last_tier.discount %}
    {% break %}
  {% endif %}
{% endfor %}

{% if lowest_price %}
  {{ cart.currency.symbol }}{{ lowest_price }}
{% endif %}