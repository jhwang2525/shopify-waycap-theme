{% if section.settings.category_menu != blank %}
<div class="category-btn">
   <button type="button" class="align-items-center category-menu btn">
      <span class="i-icon i-icon-list-bottom">
         <svg width="26" height="26" viewBox="0 0 48 48" fill="none">
            <path d="M8 42C10.2091 42 12 40.2091 12 38C12 35.7909 10.2091 34 8 34C5.79086 34 4 35.7909 4 38C4 40.2091 5.79086 42 8 42Z" fill="currentColor" stroke="currentColor" stroke-width="3" stroke-linejoin="round"></path>
            <path d="M8 12C9.10457 12 10 11.1046 10 10C10 8.89543 9.10457 8 8 8C6.89543 8 6 8.89543 6 10C6 11.1046 6.89543 12 8 12Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"></path>
            <path d="M8 26C9.10457 26 10 25.1046 10 24C10 22.8954 9.10457 22 8 22C6.89543 22 6 22.8954 6 24C6 25.1046 6.89543 26 8 26Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"></path>
            <path d="M20 24H44" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="round"></path>
            <path d="M20 38H44" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="round"></path>
            <path d="M20 10H44" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="round"></path>
         </svg>
      </span>
      <b class="ms-4 text-base uppercase">{{ linklists[section.settings.category_menu].title | upcase }}</b>
   </button>
   <div class="absolute z-12 w-full category-dropdown">
     <div class="relative flex h-126 flex-col rounded-lg 2xl:h-145.5 category-dropdown-in">
       <div class="category-dropdown-wrp">
         {% for link in linklists[section.settings.category_menu].links %}
           <div class="group">
                {% assign link_title = link.title | strip %}
          
                {% assign is_category_menu = false %}
                {% if section.blocks.size > 0 %}
                  {% for block in section.blocks %}
                    {% assign block_title = block.settings.category-menu | strip %}
                    {% if block_title == link_title  %}
                      {% assign is_category_menu = true %}
                      {% assign category_menu_block = block %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
             
             <div class="relative z-1 h-10.5">
                <a href="{{ link.url }}" class="flex h-full align-items-center justify-content-between px-4 group-hover" title="{{ link.title }}">
                   <div class="flex align-items-center">
                      <h3 class="text-sm">{{ link.title }}</h3>
                      {% if category_menu_block.settings.show_hot_icon %}
                      <div class="basic_image h-auto w-3"><img src="{{ 'picture.png' | file_url }}" alt="hot icon" class="h-full object-contain w-full"></div>
                      {% endif %}
                   </div>
                   {% if is_category_menu %}
                     <span class="i-icon i-icon-right flex align-items-center">
                        <svg width="1em" height="1em" viewBox="0 0 48 48" fill="none">
                           <path d="M19 12L31 24L19 36" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                     </span>
                   {% endif %}
                </a>
             </div>
             {% if is_category_menu %}
             <div class="category-drp-wrp absolute top-0 hidden h-full group-hover:block">
                <div class="flex h-full overflow-hidden rounded-e-lg py-4">
                   <div class="scrollbar h-full w-180 overflow-y-auto px-6">
                     {% for i in (1..5) %}
                       {% assign forloop_index = forloop.index %}
                       {% capture title %}title_{{ i }}{% endcapture %}
                       {% capture show_hot_icon %}show_hot_icon_{{ i }}{% endcapture %}
                        <div class="{% unless forloop.first %}mt-8{% endunless %}">
                           {% if category_menu_block.settings[title] != blank %}
                           <a href="javascript:void(0)" class="mb-3 block cursor-pointer" title="Women's Shoes">
                              <div class="flex items-center">
                                 <span>{{ category_menu_block.settings[title] }}</span>
                                  {% if category_menu_block.settings[show_hot_icon] %}
                                    <div class="basic_image ms-1 w-3"><img src="{{ 'picture.png' | file_url }}" alt="hot icon" class="h-full object-contain w-full"></div>
                                  {% endif %}
                                 <span class="i-icon i-icon-right flex align-items-center text-xl">
                                    <svg width="1em" height="1em" viewBox="0 0 48 48" fill="none">
                                       <path d="M19 12L31 24L19 36" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                 </span>
                              </div>
                           </a>
                           {% endif %}
                           <div class="grid grid-cols-6 gap-x-6 gap-y-4 text-xs">
                              {% for i in (1..12) %}
                                {% capture menu_title %}menu_title_{{ forloop_index }}{{ i }}{% endcapture %}
                                {% capture menu_image %}menu_image_{{ forloop_index }}{{ i }}{% endcapture %}
                                {% capture menu_url %}menu_url_{{ forloop_index }}{{ i }}{% endcapture %}
                                {% if category_menu_block.settings[menu_image] != blank or category_menu_block.settings[menu_title] != blank %}
                                <a href="{{ category_menu_block.settings[menu_url] }}" title="{{ category_menu_block.settings[menu_title] }}">
                                  {% if category_menu_block.settings[menu_image] != blank %}
                                   <div class="w-full">
                                      <div class="basic_image ratio rounded-full">
                                        {% render 'responsive-image' with category_menu_block.settings[menu_image], default_size: '335x500', class: 'h-full object-cover w-full' %}
                                      </div>
                                   </div>
                                  {% endif %}
                                  {% if category_menu_block.settings[menu_title] != blank %}
                                   <div class="mt-2 flex flex-wrap justify-center text-center">
                                      <span class="text-xs">{{ category_menu_block.settings[menu_title] }}</span><!---->
                                   </div>
                                  {% endif %}
                                </a>
                                {% endif %}
                              {% endfor %}
                           </div>
                        </div>
                     {% endfor %}
                   </div>
                   <div class="scrollbar h-full w-64 overflow-y-auto px-6">
                      <div class="grid grid-cols-2 gap-6">
                         {% if category_menu_block.settings.right_Cat-title != blank %}
                         <div class="col-span-2">
                            <div class="mx-auto w-52 rounded-md border text-center text-sm leading-9">{{ category_menu_block.settings.right_Cat-title }}</div>
                         </div>
                         {% endif %}
                         <!-- 'rounded-lg' for type class -->
                         {% for i in (1..10) %}
                            {% capture right_menu_title %}right_menu_title_{{ i }}{% endcapture %}
                            {% capture right_menu_image %}right_menu_image_{{ i }}{% endcapture %}
                            {% capture right_menu_url %}right_menu_url_{{ i }}{% endcapture %}
                            {% if category_menu_block.settings[right_menu_image] != blank or category_menu_block.settings[right_menu_title] != blank %}
                            <div class="{% unless category_menu_block.settings.round_images %}col-span-2{% endunless %}">
                              <a href="{{ category_menu_block.settings[right_menu_url] }}" class="mx-auto block cursor-pointer" title="Spring&amp;Autumn">
                                 {% if category_menu_block.settings[right_menu_image] != blank %}<div class="w-full">
                                    <div class="basic_image ratio{% if category_menu_block.settings.round_images %} rounded-1/2{% else %} rounded-lg{% endif %}">{% render 'responsive-image' with category_menu_block.settings[right_menu_image], default_size: '335x500', class: 'h-full object-cover w-full' %}</div>
                                 </div>{% endif %}
                                 {% if category_menu_block.settings[right_menu_title] != blank %}<div class="mt-2 px-1 text-center text-xs">{{ category_menu_block.settings[right_menu_title] }}</div>{% endif %}
                              </a>
                            </div>
                            {% endif %}
                         {% endfor %}
                      </div>
                   </div>
                </div>
             </div>
             {% endif %}
          </div>
         {% endfor %}
       </div>
     </div>
   </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const categoryBtn = document.querySelector('.category-btn');
    const categoryMenu = document.querySelector('.category-menu');

    if (categoryBtn && categoryMenu) {
      categoryMenu.addEventListener('mouseover', function() {
        categoryBtn.classList.add('active');
      });

      categoryBtn.addEventListener('mouseout', function(event) {
        if (!categoryBtn.contains(event.relatedTarget)) {
          categoryBtn.classList.remove('active');
        }
      });
    }
  });
</script>

